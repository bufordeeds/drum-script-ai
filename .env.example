# Nothing is required: `docker compose up --build` works without a .env file.

# Optional: alternative URL for the Demucs htdemucs checkpoint if Meta's CDN is unreachable
# (the file's sha256 is verified either way).
# DRUMSCRIPT_DEMUCS_MIRROR=https://huggingface.co/anchor-flux/demucs-htdemucs/resolve/main/htdemucs.th
